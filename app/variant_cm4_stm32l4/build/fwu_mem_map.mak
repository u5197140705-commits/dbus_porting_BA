# Module: FWU_ROMLOADER
# Make variables
FWU_ROMLOADER_START_ADDRESS ?= 8000000
FWU_ROMLOADER_END_ADDRESS ?= 80007ff
FWU_ROMLOADER_SIZE ?= 800
# Definitions
defines += FWU_ROMLOADER_START_ADDRESS=UINT32_C(0x8000000)
defines += FWU_ROMLOADER_END_ADDRESS=UINT32_C(0x80007ff)
defines += FWU_ROMLOADER_SIZE=UINT32_C(0x800)

# Module: FWU_APPLICATION
# Make variables
FWU_APPLICATION_START_ADDRESS ?= 8000800
FWU_APPLICATION_END_ADDRESS ?= 807ffff
FWU_APPLICATION_SIZE ?= 7f800
# Definitions
defines += FWU_APPLICATION_START_ADDRESS=UINT32_C(0x8000800)
defines += FWU_APPLICATION_END_ADDRESS=UINT32_C(0x807ffff)
defines += FWU_APPLICATION_SIZE=UINT32_C(0x7f800)


