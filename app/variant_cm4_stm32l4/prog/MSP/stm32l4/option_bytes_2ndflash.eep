; Option bytes settings for STM32F0
1FFF7800 AA F8 8F FF ; RDB, USERopt
1FFF7804 55 07 70 00 ; nRDP nUSERopt
1FFF7808 FF F7 FF FF ; PCROP1_STRT
1FFF780C 00 08 00 00 ; nPCROP1_STRT
1FFF7810 00 00 FF FF ; PCROP1_END
1FFF7814 FF FF 00 00 ; nPCROP1_END
1FFF7818 FF FF 00 FF ; WRP1A_STRT, WRP1A_END
1FFF781C 00 00 FF 00 ; nWRP1A_STRT, nWRP1A_END
1FFF7820 FF FF 00 FF ; WRP1B_STRT, WRP1B_END
1FFF7824 00 00 FF 00 ; nWRP1B_STRT, nWRP1B_END
;second Flash bank (cannot be programmed by ST Link, but RAM-Loader)
;1FFFF808 FF FF FF FF ; PCROP1_STRT
;1FFFF80C 00 00 00 00 ; nPCROP1_STRT
;1FFFF810 00 00 00 00 ; PCROP1_END
;1FFFF814 FF FF FF FF ; nPCROP1_END
;1FFFF818 FF 00 00 00 ; WRP1A_STRT, WRP1A_END
;1FFFF81C 00 FF FF FF ; nWRP1A_STRT, nWRP1A_END
;1FFFF820 FF 00 00 00 ; WRP1B_STRT, WRP1B_END
;1FFFF824 00 FF FF FF ; nWRP1B_STRT, nWRP1B_END

