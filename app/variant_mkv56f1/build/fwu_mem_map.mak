#  PROJECT          Generic SW
#*******************************************************************************
#  Description      File contains make variables and definitions for FWU modules
#                   This file is automatically generated, any modification will
#                   be rewritten at the start of build!
#*******************************************************************************

# Module: FWU_ROMLOADER
# Make variables
FWU_ROMLOADER_START_ADDRESS ?= 10000000
FWU_ROMLOADER_END_ADDRESS ?= 10000fff
FWU_ROMLOADER_SIZE ?= 1000
# Definitions
defines += FWU_ROMLOADER_START_ADDRESS=UINT32_C(0x10000000)
defines += FWU_ROMLOADER_END_ADDRESS=UINT32_C(0x10000fff)
defines += FWU_ROMLOADER_SIZE=UINT32_C(0x1000)

# Module: FWU_APPLICATION
# Make variables
FWU_APPLICATION_START_ADDRESS ?= 10001000
FWU_APPLICATION_END_ADDRESS ?= 100fffff
FWU_APPLICATION_SIZE ?= ff000
# Definitions
defines += FWU_APPLICATION_START_ADDRESS=UINT32_C(0x10001000)
defines += FWU_APPLICATION_END_ADDRESS=UINT32_C(0x100fffff)
defines += FWU_APPLICATION_SIZE=UINT32_C(0xff000)


