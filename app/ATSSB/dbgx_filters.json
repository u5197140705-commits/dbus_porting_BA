{
    "dbgx_filters":[
        {
            "domain": "DBGX_FILTERS_SSB_APP",
            
            "__comments__":[
                "This file is the central place to configure all static and dynamic filters of the debug_extended component.   ",
                "There are two filter types ",
                "  - static filter:  def / undef",
                "  - dynamic filter: on  / off"
            ],
            
            "level":[
                ["ERR"  , "undef" , "off", "This field is optional for comments"],
                ["WARN" , "undef" , "off", "This field is optional for comments"],
                ["INFO" , "undef" , "off", "This field is optional for comments"]
            ],
            
            "scenario":[
                ["SSB_CDIRECT_APP", "def"     , "on"  , "Direct calls application"],
                ["SSB_CBACK_APP"  , "undef"   , "off" , "Callbacks application"]
            ]
        }
    ]
}
