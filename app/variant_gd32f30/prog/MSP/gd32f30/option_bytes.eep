; Option bytes settings for GD32F30
1FFFF800 A5 5A ; OB_SPC and OB_SPC_N
1FFFF802 FF 00 ; user option (OB_USER) and complement (OB_USER_N)
1FFFF804 FF 00 FF 00 ; OB_DATA[7:0], OB_DATA_N[7:0],OB_DATA[15:8] and OB_DATA_N[15:8]
1FFFF808 FF 00 FF 00 ; OB_WP[7:0],OB_WP_N[7:0],OB_WP[15:8] and OB_WP_N[15:8]
1FFFF80C FF 00 FF 00 ; OB_WP[23:16],OB_WP_N[23:16],OB_WP[31:24],OB_WP_N[31:24]
