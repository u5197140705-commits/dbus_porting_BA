; Option bytes settings for STM32L4
1FFF7800 AA F8 EF FF ; RDP:8bit, USERopt:24bit
1FFF7804 55 07 10 00 ; nRDP:8bit, nUSERopt:24bit
1FFF7808 FF FF FF FF ; PCROP1_STRT:16bit, Unused:16bit
1FFF780C 00 00 00 00 ; nPCROP1_STRT:16bit, Unused:16bit
1FFF7810 00 00 FF FF ; PCROP1_END:16bit, Unused:15bit, PCROP_RDP:1bit
1FFF7814 FF FF 00 00 ; nPCROP1_END:16bit, Unused:15bit, nPCROP_RDP:1bit
1FFF7818 FF FF 00 FF ; WRP1A_STRT:8bit, Unused:8bit, WRP1A_END:8bit, Unused:8bit
1FFF781C 00 00 FF 00 ; nWRP1A_STRT:8bit, Unused:8bit, nWRP1A_END:8bit, Unused:8bit
1FFF7820 FF FF 00 FF ; WRP1B_STRT:8bit, Unused:8bit, WRP1B_END:8bit, Unused:8bit
1FFF7824 00 00 FF 00 ; nWRP1B_STRT:8bit, Unused:8bit, nWRP1B_END:8bit, Unused:8bit

; Second Flash bank (cannot be programmed by ST-Link, but RAM-Loader)
;1FFFF808 FF FF FF FF ; PCROP2_STRT:16bit, Unused:16bit
;1FFFF80C 00 00 00 00 ; nPCROP2_STRT:16bit, Unused:16bit
;1FFFF810 00 00 FF FF ; PCROP2_END:16bit, Unused:16bit
;1FFFF814 FF FF 00 00 ; nPCROP2_END:16bit, Unused:16bit
;1FFFF818 FF FF 00 FF ; WRP2A_STRT:8bit, Unused:8bit, WRP2A_END:8bit, Unused:8bit
;1FFFF81C 00 00 FF 00 ; nWRP2A_STRT:8bit, Unused:8bit, nWRP2A_END:8bit, Unused:8bit
;1FFFF820 FF FF 00 FF ; WRP2B_STRT:8bit, Unused:8bit, WRP2B_END:8bit, Unused:8bit
;1FFFF824 00 00 FF 00 ; nWRP2B_STRT:8bit, Unused:8bit, nWRP2B_END:8bit, Unused:8bit
