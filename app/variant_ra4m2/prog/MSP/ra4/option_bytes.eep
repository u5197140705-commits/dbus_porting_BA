; Option bytes settings for RA4M2
;  +------------------+
;  | FUNC_NAME_SEL[n] +---------+
;  +------------------+         |
;                               V
;  +------------------+       +--+
;  |   FUNC_NAME[n]   +=======+ 1 \
;  +------------------+       |    |    Applied value
;                             |    +================>
;  +------------------+       |    |
;  | FUNC_NAME_SEC[n] +=======+ 0 /
;  +------------------+       +--+
;
; The relationship between the bit of PBPS, PBPS_SEC and bit of BPS, BPS_SEC
; +=============================================================================================+
; | PBPS bit |  BPS bit |           Content                                                     |
; +=============================================================================================+
; |     1    |      1   | Valid Programming & erasure of corresponding block                    |
; +----------+----------+-----------------------------------------------------------------------+
; |     1    |      0   | Invalid Programming & erasure of corresponding block. This protection |
; |          |          | can be canceled by FBPROT0 or FBPROT1 registers.                      |
; +----------+----------+-----------------------------------------------------------------------+
; |     0    |      1   | Can not set this condition                                            |
; +----------+----------+-----------------------------------------------------------------------+
; |     1    |      1   | Permanently invalid Programming & erasure of corresponding block      |
; +----------+----------+-----------------------------------------------------------------------+
;
; !Data for Programming Reserved Areas and Reserved Bits in the Option-Setting Memory!
; 
; Write 1 to all bits in reserved areas of the option-setting memory which are within the scope of programming,
; If 0 is written to these bits, then normal operation cannot be guaranteed.
;
; Address 0100A100
; bits|        7        6        5        4      |          3             2         |      1     | 0 |
;     +==============================================================================================+
;     |                 IWDTCKS                  |              IWDTTOPS            | IWDT STRT  | - |
;     +==============================================================================================+
;     | IWDTCKS - Clock Frequency Division Ratio | IWDTTOPS - Timeout Period Select | 0- Auto    |   |
;     | 0x0 - IWDTCLK/1                          |          0 0 - 128 cycles        |    Start   |   |
;     | 0x2 - IWDTCLK/16                         |          0 1 - 512 cycles        |    Mode    |   |
;     | 0x3 - IWDTCLK/32                         |          1 0 - 1024 cycles       |            |   |
;     | 0x4 - IWDTCLK/64                         |          1 1 - 2048 cycles       | 1- Disable |   |
;     | 0xF - IWDTCLK/128                        |                                  |     After  |   |
;     | 0x5 - IWDTCLK/256                        |                                  |     Reset  |   |
;     +==============================================================================================+
; Reset period formula:   (IWDTCKS/IWDTCLK) * IWDTTOPS = Reset period (s)      IWDTCLK = 15000 Hz
; Example: 0100A100 F1 FF FF FF ; Reset period set to 1,092 s
;
0100A100 FF FF FF FF ; OFS0 - Option Function Select Register 0 (Page 111 of RM)
0100A104 FF FF FF FF FF FF FF FF FF FF FF FF             ; Reserved Area
0100A110 FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF ; Reserved Area
0100A120 FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF ; Reserved Area
0100A130 FF FF FF FF ; Reserved Area
0100A134 FF FF FF FF ; SAS - Startup Area Setting Register (Page 114 of RM)
0100A138 FF FF FF FF FF FF FF FF ; Reserved Area
0100A140 FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF ; Reserved Area
0100A150 FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF ; Reserved Area
0100A160 FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF ; Reserved Area
0100A170 FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF ; Reserved Area
0100A180 FF FF FF FF ; OFS1 - Option Function Select Register 1 - non-secure (Page 115 of RM)
0100A184 FF FF FF FF FF FF FF FF FF FF FF FF             ; Reserved Area
0100A190 FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF ; Reserved Area
0100A1A0 FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF ; Reserved Area
0100A1B0 FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF ; Reserved Area
0100A1C0 FF FF FF FF ; BPS - Block Protect Setting Register - non-secure
0100A1C4 FF FF FF FF FF FF FF FF FF FF FF FF             ; Reserved Area
0100A1D0 FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF ; Reserved Area
0100A1E0 FF FF FF FF ; PBPS - Permanent Block Protect Setting Register - non-secure
0100A1E4 FF FF FF FF FF FF FF FF FF FF FF FF             ; Reserved Area
0100A1F0 FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF ; Reserved Area
0100A200 FF F9 FF FF ; OFS1_SEC - Option Function Select Register 1 - secure 
0100A204 FF FF FF FF FF FF FF FF FF FF FF FF             ; Reserved Area
0100A210 FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF ; Reserved Area
0100A220 FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF ; Reserved Area
0100A230 FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF ; Reserved Area
0100A240 FF FF FF FF ; BPS_SEC - Block Protect Setting Register - secure
0100A244 FF FF FF FF FF FF FF FF FF FF FF FF             ; Reserved Area
0100A250 FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF ; Reserved Area
0100A260 FF FF FF FF ; PBPS_SEC - Permanent Block Protect Setting Register - secure
0100A264 FF FF FF FF FF FF FF FF FF FF FF FF             ; Reserved Area
0100A270 FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF ; Reserved Area
0100A280 F8 F8 FF FF ; OFS1_SEL - Option Function Select Register 1 - (security attribution)
0100A284 FF FF FF FF FF FF FF FF FF FF FF FF             ; Reserved Area
0100A290 FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF ; Reserved Area
0100A2A0 FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF ; Reserved Area
0100A2B0 FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF ; Reserved Area
0100A2C0 FF FF FF FF ; BPS_SEL - Block Protect Setting Register - (security attribution)
0100A2C4 FF FF FF FF FF FF FF FF FF FF FF FF             ; Reserved Area
0100A2D0 FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF ; Reserved Area
0100A2E0 FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF ; Reserved Area
0100A2F0 FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF ; Reserved Area


