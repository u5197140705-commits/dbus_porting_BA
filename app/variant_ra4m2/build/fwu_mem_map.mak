# Module: FWU_ROMLOADER
# Make variables
FWU_ROMLOADER_START_ADDRESS ?= 0
FWU_ROMLOADER_END_ADDRESS ?= 3fff
FWU_ROMLOADER_SIZE ?= 4000
# Definitions
defines += FWU_ROMLOADER_START_ADDRESS=UINT32_C(0x0)
defines += FWU_ROMLOADER_END_ADDRESS=UINT32_C(0x3fff)
defines += FWU_ROMLOADER_SIZE=UINT32_C(0x4000)

# Module: FWU_APPLICATION
# Make variables
FWU_APPLICATION_START_ADDRESS ?= 4000
FWU_APPLICATION_END_ADDRESS ?= 7ffff
FWU_APPLICATION_SIZE ?= 7c000
# Definitions
defines += FWU_APPLICATION_START_ADDRESS=UINT32_C(0x4000)
defines += FWU_APPLICATION_END_ADDRESS=UINT32_C(0x7ffff)
defines += FWU_APPLICATION_SIZE=UINT32_C(0x7c000)


