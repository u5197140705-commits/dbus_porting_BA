void _SetupTarget(void) {
  //
  // this function is intentionally empty because both inital PC and
  // initial SP were chosen not to be set
  //
}

/*********************************************************************
*
*       RTOS_SaveTraceBufferToFile
*
* Function description
*   Routine to store the RTOS_traceBuffer (snapshot) in to RTOS_trace_data.bin file.
*   The RTOS_trace_data.bin can be used with Percepio Tracealyser.
*
**********************************************************************
*/
void RTOS_SaveTraceBufferToFile(void)
{
  Target.SaveMemory("$(ProjectDir)/Traces/RTOS_trace_data.bin", Elf.GetExprValue ("RTOS_traceBuffer"), Elf.GetExprValue ("sizeof(RTOS_traceBuffer)"));
}

