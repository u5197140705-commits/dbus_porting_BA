/*********************************************************************
*
*       OnProjectLoad
*
* Function description
*   Project load routine. Required.
*
**********************************************************************
*/
void OnProjectLoad (void) {
  //
  // Dialog-generated settings
  //
  Project.SetDevice ("MKV56F1M0xxx24");
  Project.SetHostIF ("USB", "");
  Project.SetTargetIF ("SWD");
  Project.SetTIFSpeed ("5 MHz");
  Project.AddSvdFile ("$(InstallDir)/Config/CPU/Cortex-M7F.svd");
  Project.AddSvdFile ("$(InstallDir)/Config/Peripherals/ARMv7M.svd");
  //
  // User settings
  //
  Project.AddSvdFile ("$(ProjectDir)/svd/MKV56F24.xml");

  //File.Open ("$(ProjectDir)/../../out/variant_mkv56f1/romLoader/bin/romLoader.elf");
  File.Open ("$(ProjectDir)/../../out/variant_mkv56f1/MyVariant/bin/MyVariant.elf");

  Window.Add ("Watched Data 1", "RTD_TimeMonitor"); 
  Window.Add ("Watched Data 1", "RTD_RuntimeCatalogue");
}

