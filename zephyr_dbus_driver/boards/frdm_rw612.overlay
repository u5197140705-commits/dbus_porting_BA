/* frdm_rw612.overlay
 * Example for SPI-Master-Konfiguration auf NXP FRDM-RW612
 */

#include <nxp/rw/RW612-pinctrl.h>

// Custom pinmux definitions for Flexcomm 1 SPI
#define IO_MUX_FC1_SPI_SCK_IO7 \
	(IOMUX_GPIO_IDX(7) | IOMUX_TYPE(IOMUX_FLEXCOMM) | \
	IOMUX_FLEXCOMM_IDX(1) | IOMUX_FLEXCOMM_BIT(0))

#define IO_MUX_FC1_SPI_MOSI_IO9 \
	(IOMUX_GPIO_IDX(9) | IOMUX_TYPE(IOMUX_FLEXCOMM) | \
	IOMUX_FLEXCOMM_IDX(1) | IOMUX_FLEXCOMM_BIT(2))

#define IO_MUX_FC1_SPI_MISO_IO8 \
	(IOMUX_GPIO_IDX(8) | IOMUX_TYPE(IOMUX_FLEXCOMM) | \
	IOMUX_FLEXCOMM_IDX(1) | IOMUX_FLEXCOMM_BIT(1))

/ {
    aliases {
        dbus-spi = &flexcomm1; // Alias points to the flexcomm1 node itself
    };
};

&flexcomm1 {
    status = "okay";
    pinctrl-0 = <&flexcomm1_spi_default>;
    pinctrl-names = "default";

    compatible = "nxp,lpc-spi";
    #address-cells = <1>;
    #size-cells = <0>;
    reg = <0x50107000 0x1000>; // Base address and size for flexcomm1
    interrupts = <15 0>;
    clock-frequency = <1000000>; // 1 MHz, adjust as needed
    label = "DBUS_SPI";
    cs-gpios = <&hsgpio0 6 GPIO_ACTIVE_LOW>; // Example: Using D10 from Arduino header, adjust as needed
};

&pinctrl {
    flexcomm1_spi_default: flexcomm1_spi_default {
        pinmux = <IO_MUX_FC1_SPI_SCK_IO7>,  // SCK
                 <IO_MUX_FC1_SPI_MOSI_IO9>,  // MOSI
                 <IO_MUX_FC1_SPI_MISO_IO8>,  // MISO
                 <IO_MUX_FC1_SPI_SS0_IO6>;  // SSELN0
        slew-rate = "normal";
    };
};